            "state": "translated",
            "value": "Горизонтальна вісь показує кутову частоту ω в логарифмічному масштабі (log₁₀ω)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가로축은 로그 눈금의 각주파수 ω입니다 (log₁₀ω)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "横轴为对数刻度的角频率 ω（log₁₀ω）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "橫軸為對數刻度的角頻率 ω（log₁₀ω）。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्षैतिज अक्ष लघुगणकीय पैमाने पर कोणीय आवृत्ति ω है (log₁₀ω)।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনুভূমিক অক্ষ লগারিদমিক স্কেলে কৌণিক কম্পাঙ্ক ω (log₁₀ω)।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "افقی محور لوگارتھمی پیمانے پر زاویائی تعدد ω ہے (log₁₀ω)۔"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கிடைமட்ட அச்சு மடக்கை அளவில் கோண அதிர்வெண் ω ஆகும் (log₁₀ω)."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "క్షితిజ సమాంతర అక్షం సంవర్గమాన ప్రమాణంలో కోణీయ పౌనఃపున్యం ω (log₁₀ω)."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आडवा अक्ष लघुगणकीय मापनावरील कोनीय वारंवारता ω आहे (log₁₀ω)."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આડું અક્ષ લઘુગણકીય સ્કેલ પર કોણીય આવર્તન ω છે (log₁₀ω)."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹਰੀਜੱਟਲ ਧੁਰਾ ਲਘੂਗਣਕੀ ਪੈਮਾਨੇ ਉੱਤੇ ਕੋਣੀ ਬਾਰੰਬਾਰਤਾ ω ਹੈ (log₁₀ω)।"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തിരശ്ചീന അക്ഷം ലോഗരിതമിക് സ്കെയിലിലെ കോണീയ ആവൃത്തി ω ആണ് (log₁₀ω)."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅಡ್ಡ ಅಕ್ಷವು ಲಘುಗಣಕ ಪ್ರಮಾಣದಲ್ಲಿನ ಕೋನೀಯ ಆವೃತ್ತಿ ω ಆಗಿದೆ (log₁₀ω)."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Paksi mendatar ialah frekuensi sudut ω pada skala logaritma (log₁₀ω)."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang pahalang na axis ay angular frequency ω sa logarithmic scale (log₁₀ω)."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mhimili mlalo unaonyesha frekwensi ya angular ω katika skeli ya logaritimu (log₁₀ω)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הציר האופקי הוא התדר הזוויתי ω בסולם לוגריתמי (log₁₀ω)."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Хоризонталната ос е ъгловата честота ω в логаритмична скала (log₁₀ω)."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vodoravna os prikazuje kutnu frekvenciju ω na logaritamskoj ljestvici (log₁₀ω)."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Хоризонтална оса приказује угаону фреквенцију ω на логаритамској скали (log₁₀ω)."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L'eix horitzontal és la freqüència angular ω en escala logarítmica (log₁₀ω)."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "محور افقی فرکانس زاویه‌ای ω را در مقیاس لگاریتمی (log₁₀ω) نشان می‌دهد."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vodoravna os prikazuje kotno frekvenco ω na logaritemski lestvici (log₁₀ω)."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Horizontalioji ašis rodo kampinį dažnį ω logaritminėje skalėje (log₁₀ω)."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Horizontālā ass rāda leņķisko frekvenci ω logaritmiskā skalā (log₁₀ω)."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Horisontaaltelg näitab nurksagedust ω logaritmilisel skaalal (log₁₀ω)."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Lárétti ásinn sýnir horntíðni ω á logra kvarða (log₁₀ω)."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Horizontalna osa prikazuje ugaonu frekvenciju ω na logaritamskoj skali (log₁₀ω)."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Хоризонталната оска ја прикажува аголната фреквенција ω на логаритамска скала (log₁₀ω)."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Boshti horizontal tregon frekuencën këndore ω në shkallë logaritmike (log₁₀ω)."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Üfüqi ox bucaq tezliyi ω-nı loqarifmik miqyasda göstərir (log₁₀ω)."
          }
        }
      }
    },
    "If you find this app useful, please consider leaving a review on the App Store. It really helps!": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もしよろしければ、App Store でレビューを書いていただけると励みになります。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا وجدت التطبيق مفيدًا، يرجى التفكير في ترك تقييم على App Store. سيساعدنا ذلك كثيرًا!"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika aplikasi ini bermanfaat, pertimbangkan untuk memberikan ulasan di App Store. Dukungan Anda sangat membantu!"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu thấy ứng dụng hữu ích, hãy cân nhắc viết đánh giá trên App Store. Điều đó giúp ích rất nhiều!"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากแอปนี้มีประโยชน์ โปรดพิจารณาเขียนรีวิวบน App Store ซึ่งช่วยเราได้มาก!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn dir die App gefällt, hinterlasse bitte eine Bewertung im App Store. Das hilft uns sehr!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si cette app vous est utile, pensez à laisser un avis sur l’App Store. Cela nous aide beaucoup !"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si esta app te resulta útil, considera dejar una reseña en el App Store. ¡Nos ayuda mucho!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se trovi utile questa app, lascia una recensione sull’App Store. Ci aiuta molto!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se este app for útil para você, considere avaliá-lo na App Store. Isso ajuda muito!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vind je deze app nuttig? Laat dan een beoordeling achter in de App Store. Dat helpt ons enorm!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli aplikacja jest przydatna, rozważ wystawienie oceny w App Store. To bardzo pomaga!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если приложение вам полезно, пожалуйста, оставьте отзыв в App Store. Это очень помогает!"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se esta aplicação lhe for útil, considere deixar uma avaliação na App Store. Ajuda-nos muito!"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du gillar appen får du gärna lämna ett omdöme i App Store. Det hjälper oss mycket!"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du finder appen nyttig, vil vi sætte pris på en anmeldelse i App Store. Det hjælper meget!"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du synes appen er nyttig, kan du gjerne legge igjen en anmeldelse i App Store. Det hjelper mye!"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos sovelluksesta on sinulle hyötyä, jätäthän arvion App Storessa. Se auttaa paljon!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uygulamayı yararlı buluyorsanız App Store’da bir değerlendirme bırakmayı düşünün. Bu bize çok yardımcı olur!"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud je pro vás aplikace užitečná, zvažte její hodnocení v App Storu. Moc nám to pomůže!"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak je pre vás aplikácia užitočná, zvážte jej hodnotenie v App Store. Veľmi nám to pomôže!"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha hasznosnak találja az alkalmazást, kérjük, értékelje az App Store-ban. Ez sokat segít!"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă aplicația îți este utilă, lasă o recenzie în App Store. Ne ajută foarte mult!"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν βρίσκετε χρήσιμη την εφαρμογή, αφήστε μια αξιολόγηση στο App Store. Μας βοηθά πολύ!"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо застосунок корисний для вас, залиште відгук в App Store. Це дуже допомагає!"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱이 유용하다면 App Store에 리뷰를 남겨 주세요. 큰 도움이 됩니다!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果您觉得此应用有用，请考虑在 App Store 留下评价。这对我们帮助很大！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果您覺得此 App 有用，歡迎在 App Store 留下評論。這對我們很有幫助！"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि यह ऐप उपयोगी लगे, तो कृपया App Store पर समीक्षा लिखें। इससे बहुत मदद मिलती है!"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপটি উপকারী মনে হলে App Store-এ একটি পর্যালোচনা দিন। এটি খুব সাহায্য করে!"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر یہ ایپ مفید لگے تو براہ کرم App Store پر جائزہ لکھیں۔ اس سے بہت مدد ملتی ہے!"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த ஆப் பயனுள்ளதாக இருந்தால் App Store இல் மதிப்புரை எழுதுங்கள். அது மிகவும் உதவும்!"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ యాప్ ఉపయోగపడితే App Storeలో సమీక్ష రాయండి. ఇది ఎంతో సహాయపడుతుంది!"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हा अॅप उपयुक्त वाटल्यास App Store वर पुनरावलोकन लिहा. त्याने खूप मदत होते!"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ઍપ ઉપયોગી લાગે તો App Store પર સમીક્ષા લખો. તેનાથી ઘણી મદદ મળે છે!"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜੇ ਇਹ ਐਪ ਲਾਭਦਾਇਕ ਲੱਗੇ ਤਾਂ App Store ਉੱਤੇ ਸਮੀਖਿਆ ਲਿਖੋ। ਇਸ ਨਾਲ ਬਹੁਤ ਮਦਦ ਮਿਲਦੀ ਹੈ!"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ആപ്പ് ഉപകാരപ്രദമാണെങ്കിൽ App Store ൽ ഒരു അവലോകനം എഴുതുക. അത് ഏറെ സഹായിക്കും!"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಆ್ಯಪ್ ಉಪಯುಕ್ತವೆನಿಸಿದರೆ App Store ನಲ್ಲಿ ವಿಮರ್ಶೆ ಬರೆಯಿರಿ. ಅದು ತುಂಬಾ ಸಹಾಯ ಮಾಡುತ್ತದೆ!"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika aplikasi ini berguna, sila pertimbangkan untuk memberikan ulasan di App Store. Ia amat membantu!"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kung kapaki-pakinabang ang app na ito, pag-isipang mag-iwan ng review sa App Store. Malaking tulong ito!"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikiwa programu hii ni muhimu kwako, tafadhali fikiria kuandika maoni kwenye App Store. Yanasaidia sana!"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם האפליקציה מועילה לך, נשמח לקבל חוות דעת ב־App Store. זה עוזר מאוד!"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ако приложението ви е полезно, помислете дали да не оставите отзив в App Store. Това много помага!"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako vam je aplikacija korisna, razmislite o recenziji u trgovini App Store. To nam mnogo znači!"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ако вам је апликација корисна, размислите о томе да оставите рецензију у App Store продавници. То много помаже!"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si l'aplicació et resulta útil, considera deixar una ressenya a l'App Store. Ens ajuda molt!"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر این برنامه برایتان مفید است، لطفاً در App Store نظر خود را بنویسید. این کار کمک زیادی می‌کند!"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če vam je aplikacija uporabna, razmislite o oceni v trgovini App Store. To nam veliko pomaga!"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
