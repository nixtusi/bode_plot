        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja lietotne ir noderīga, lūdzu, apsveriet iespēju atstāt atsauksmi veikalā App Store. Tas ļoti palīdz!"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui see rakendus on teile kasulik, kaaluge arvustuse jätmist App Store'is. See aitab palju!"
