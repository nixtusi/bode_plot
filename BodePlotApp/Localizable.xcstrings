        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ef þér finnst appið gagnlegt máttu endilega skrifa umsögn í App Store. Það hjálpar mikið!"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako vam je aplikacija korisna, ostavite recenziju u App Storeu. To nam mnogo znači!"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ако апликацијата ви е корисна, оставете рецензија во App Store. Тоа многу ни помага!"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Nëse aplikacioni ju duket i dobishëm, lini një vlerësim në App Store. Kjo na ndihmon shumë!"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tətbiqi faydalı hesab edirsinizsə, App Store-da rəy yazmağı düşünün. Bu bizə çox kömək edir!"
